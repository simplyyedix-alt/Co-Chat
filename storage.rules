rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /conversation-media/{conversationId}/{userId}/{fileName} {
      allow read: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.memberIds;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.memberIds
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*|audio/.*|application/pdf|text/.*');
    }
  }
}
