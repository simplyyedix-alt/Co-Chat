rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if owner(userId);
    }
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /friendRequests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid)
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.status in ['pending', 'accepted', 'declined'];
      allow delete: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }
    match /friendships/{friendshipId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2 && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.status == 'accepted';
      allow update: if signedIn() && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds == resource.data.memberIds && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && request.auth.uid in resource.data.memberIds;
    }
    match /blocks/{blockId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId is string && request.resource.data.blockedId != request.auth.uid;
      allow delete: if signedIn() && resource.data.blockerId == request.auth.uid;
    }
    match /conversations/{conversationId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds
        && ((request.resource.data.type == 'direct' && request.resource.data.memberIds.size() == 2)
          || (request.resource.data.type == 'group' && request.resource.data.memberIds.size() >= 3
            && request.resource.data.adminId == request.auth.uid));
      allow update: if signedIn() && request.auth.uid in resource.data.memberIds && (
        (request.resource.data.memberIds == resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'unreadCounts', 'name']))
        || (resource.data.type == 'group'
          && request.resource.data.memberIds.size() > resource.data.memberIds.size()
          && request.auth.uid in resource.data.memberIds
          && request.resource.data.adminId == resource.data.adminId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']))
        || (resource.data.type == 'group' && resource.data.adminId == request.auth.uid
          && request.resource.data.memberIds.size() < resource.data.memberIds.size()
          && request.resource.data.adminId == resource.data.adminId
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])));
      allow delete: if signedIn() && request.auth.uid in resource.data.memberIds;
      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000
          && (!('attachment' in request.resource.data) || request.resource.data.attachment is map);
        allow update: if signedIn() && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.text == resource.data.text && request.resource.data.seenBy is list;
        allow delete: if signedIn();
      }
    }
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /calls/{callId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.calleeId in request.resource.data.memberIds
        && request.resource.data.status == 'ringing';
      allow update: if signedIn()
        && (request.auth.uid == resource.data.callerId
          || request.auth.uid == resource.data.calleeId
          || (resource.data.memberIds is list && request.auth.uid in resource.data.memberIds))
        && request.resource.data.memberIds == resource.data.memberIds;
      allow delete: if signedIn()
        && (request.auth.uid == resource.data.callerId
          || request.auth.uid == resource.data.calleeId
          || (resource.data.memberIds is list && request.auth.uid in resource.data.memberIds));
    }
  }
}
